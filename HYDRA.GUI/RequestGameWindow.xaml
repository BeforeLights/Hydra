<Window x:Class="Hydra.Gui.RequestGameWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Request a Game" Height="680" Width="1000"
        WindowStartupLocation="CenterOwner" Background="#1E1E1E">
    <DockPanel>
        <!-- Header -->
        <Border DockPanel.Dock="Top" Background="#2C2C2C" Padding="14">
            <TextBlock Text="Request Game"
                       FontSize="20" FontWeight="Bold" Foreground="White"/>
        </Border>

        <!-- Body -->
        <Grid Margin="14">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- 3 cột: list | splitter | detail -->
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="360"/>
                <!-- list bên trái -->
                <ColumnDefinition Width="6"/>
                <!-- splitter -->
                <ColumnDefinition Width="*"/>
                <!-- panel chi tiết -->
            </Grid.ColumnDefinitions>

            <!-- Search bar -->
            <DockPanel Grid.Row="0" Grid.ColumnSpan="3">
                <Grid Width="480" Height="38">
                    <TextBox x:Name="txtQuery" Background="#333" Foreground="White" Padding="8"/>
                    <TextBlock Text="Type game name..." Margin="10,0,0,0"
                       Foreground="#7FFFFFFF" VerticalAlignment="Center" IsHitTestVisible="False">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Text, ElementName=txtQuery}" Value="">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
                <Button Content="Search" Height="38" Margin="8,0,0,0"
                Background="#2D8CFF" Foreground="White" Click="SearchRawg_Click"/>
            </DockPanel>

            <!-- LEFT: results -->
            <Border Grid.Row="1" Grid.Column="0"
            Background="#262626" CornerRadius="8" Padding="8" Margin="0,10,0,0">
                <StackPanel>
                    <TextBlock Text="Results" Foreground="White" FontWeight="Bold" Margin="2,0,0,8"/>
                    <ListBox x:Name="lstResults"
                     Background="#262626" Foreground="White"
                     MouseDoubleClick="lstResults_MouseDoubleClick"
                     VerticalAlignment="Stretch">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="#444" BorderThickness="0,0,0,1" Padding="8">
                                    <TextBlock Text="{Binding Name}" FontSize="14"/>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </StackPanel>
            </Border>

            <!-- SPLITTER -->
            <GridSplitter Grid.Row="1" Grid.Column="1" Width="6" Margin="4,10"
                  HorizontalAlignment="Center" VerticalAlignment="Stretch"
                  Background="#333" ShowsPreview="True"/>

            <!-- RIGHT: detail (ảnh cố định cao, desc cuộn) -->
            <Border Grid.Row="1" Grid.Column="2"
        Background="#262626" CornerRadius="8" Padding="14" Margin="10,10,0,0">
                <Grid>
                    <!-- 7 hàng rõ ràng -->
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <!-- 0: image -->
                        <RowDefinition Height="Auto"/>
                        <!-- 1: title -->
                        <RowDefinition Height="*"/>
                        <!-- 2: description (scroll) -->
                        <RowDefinition Height="Auto"/>
                        <!-- 3: platforms -->
                        <RowDefinition Height="Auto"/>
                        <!-- 4: genres -->
                        <RowDefinition Height="Auto"/>
                        <!-- 5: publishers -->
                        <RowDefinition Height="Auto"/>
                        <!-- 6: button + status -->
                    </Grid.RowDefinitions>

                    <!-- 0 -->
                    <Border Grid.Row="0" CornerRadius="6" Background="#111"
                ClipToBounds="True" MaxHeight="400">
                        <Image x:Name="imgCover" Stretch="Uniform" />
                    </Border>

                    <!-- 1 -->
                    <TextBlock x:Name="txtTitle" Grid.Row="1" Margin="0,10,0,0"
                   FontSize="18" FontWeight="Bold" Foreground="White"/>

                    <!-- 2 -->
                    <ScrollViewer Grid.Row="2" Margin="0,8,0,0" VerticalScrollBarVisibility="Auto">
                        <TextBlock x:Name="txtDesc" TextWrapping="Wrap" Foreground="LightGray"/>
                    </ScrollViewer>

                    <!-- 3 -->
                    <StackPanel Grid.Row="3" Orientation="Vertical" Margin="0,10,0,0">
                        <TextBlock>
        <Run Text="Platforms: " Foreground="LightGray"/>
        <Run x:Name="txtPlatforms" Foreground="White"/>
                        </TextBlock>

                        <TextBlock Margin="0,4,0,0">
        <Run Text="Genres: " Foreground="LightGray"/>
        <Run x:Name="txtGenres" Foreground="White"/>
                        </TextBlock>

                        <TextBlock Margin="0,4,0,0">
        <Run Text="Release Date: " Foreground="LightGray"/>
        <Run x:Name="txtReleaseDate" Foreground="White"/>
                        </TextBlock>

                        <TextBlock Margin="0,4,0,0">
        <Run Text="Publishers: " Foreground="LightGray"/>
        <Run x:Name="txtPublishers" Foreground="White"/>
                        </TextBlock>
                    </StackPanel>

                    <!-- 7: nút luôn ở hàng riêng, không đè -->
                    <StackPanel Grid.Row="7" Orientation="Horizontal" Margin="0,12,0,0">
                        <Button Content="Request This Game"
                    Background="#27AE60" Foreground="White"
                    Click="Request_Click"/>
                        <TextBlock x:Name="lblStatus" Foreground="LightGray" Margin="12,5,0,0"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

    </DockPanel>
</Window>
