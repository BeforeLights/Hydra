<Window x:Class="Hydra.Gui.AdminApproveWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Approve Suggestions"
        Height="720" Width="1200"
        Background="#1A1A1A"
        WindowStartupLocation="CenterOwner">

    <Window.Resources>
        <SolidColorBrush x:Key="PanelBg" Color="#2D2D30"/>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="White"/>
        </Style>
        <Style x:Key="Header" TargetType="TextBlock">
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#CCCCCC"/>
            <Setter Property="Margin" Value="0,6,0,2"/>
        </Style>
        <Style x:Key="FancyButton" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#007ACC"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Margin" Value="8,0,0,0"/>
        </Style>
        <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource FancyButton}">
            <Setter Property="Background" Value="#C0392B"/>
        </Style>
        <Style x:Key="SuccessButton" TargetType="Button" BasedOn="{StaticResource FancyButton}">
            <Setter Property="Background" Value="#27AE60"/>
        </Style>

        <!-- chip style cho Votes -->
        <Style x:Key="Chip" TargetType="Border">
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="Background" Value="#3C3C3C"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Margin" Value="8,0,0,0"/>
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="420"/>
            <ColumnDefinition Width="12"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.ColumnSpan="3" Orientation="Horizontal" VerticalAlignment="Center">
            <TextBlock Text="Pending Suggestions" Style="{StaticResource Header}"/>
            <Button Content="Refresh" Click="Refresh_Click" Style="{StaticResource FancyButton}" Margin="16,0,0,0"/>
            <TextBlock x:Name="txtTotal" Foreground="#CCCCCC" Margin="12,4,0,0"/>
        </StackPanel>

        <!-- LEFT: list -->
        <Border Grid.Row="1" Grid.Column="0" Background="{StaticResource PanelBg}" CornerRadius="8" Padding="10">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
                    <TextBox x:Name="txtFilter" Width="260" Height="32" Padding="8,4"
                             Background="#3C3C3C" Foreground="White"
                             BorderBrush="#555" BorderThickness="1" />
                    <Button Content="Filter" Click="Filter_Click" Style="{StaticResource FancyButton}"/>
                    <Button Content="Clear" Click="ClearFilter_Click" Style="{StaticResource FancyButton}"/>
                </StackPanel>

                <DataGrid x:Name="grid" AutoGenerateColumns="False"
                          Background="Transparent" Foreground="Black"
                          HeadersVisibility="Column" CanUserAddRows="False"
                          SelectionMode="Single" SelectionChanged="grid_SelectionChanged">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="10"/>
                        <DataGridTextColumn Header="Title" Binding="{Binding Title}" Width="*"/>
                        <DataGridTextColumn Header="Votes" Binding="{Binding Votes}" Width="10"/>
                        <DataGridTextColumn Header="Release" Binding="{Binding RawgReleased}" Width="70"/>

                        <DataGridTextColumn Header="Created" Binding="{Binding CreatedAt, StringFormat={}{0:yyyy-MM-dd HH:mm}}" Width="150"/>
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </Border>

        <!-- RIGHT: detail -->
        <Border Grid.Row="1" Grid.Column="2" Background="{StaticResource PanelBg}" CornerRadius="8" Padding="14">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="240"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- cover -->
                <Border Grid.Row="0" CornerRadius="6" Background="#111"
                     ClipToBounds="True" MaxHeight="400">
                    <Image x:Name="imgCover" Stretch="Uniform" />
                </Border>

                <!-- info -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <!-- Tiêu đề + chip lượt vote -->
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock x:Name="txtTitle" FontSize="18" FontWeight="Bold" />
                            <Border Style="{StaticResource Chip}">
                                <TextBlock>
                                    <Run Text="Votes: " Foreground="#CCCCCC"/>
                                    <Run x:Name="txtVotes" Foreground="White"/>
                                </TextBlock>
                            </Border>
                        </StackPanel>

                        <TextBlock Text="Summary" Style="{StaticResource FieldLabel}" />
                        <TextBlock x:Name="txtDesc" Foreground="White" TextWrapping="Wrap"/>

                        <TextBlock Text="Platforms" Style="{StaticResource FieldLabel}"/>
                        <TextBlock x:Name="txtPlatforms" TextWrapping="Wrap"/>

                        <TextBlock Text="Genres" Style="{StaticResource FieldLabel}"/>
                        <TextBlock x:Name="txtGenres" TextWrapping="Wrap"/>

                        <TextBlock Text="Release Date" Style="{StaticResource FieldLabel}"/>
                        <TextBlock x:Name="txtRelease" />

                        <TextBlock Text="Publishers" Style="{StaticResource FieldLabel}"/>
                        <TextBlock x:Name="txtPublishers" TextWrapping="Wrap"/>
                    </StackPanel>
                </ScrollViewer>

                <!-- actions -->
                <StackPanel Grid.Row="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,10,0,0">
                    <TextBlock Text="Default Price" Style="{StaticResource FieldLabel}" Margin="0,0,8,0"/>
                    <TextBox x:Name="txtPrice" Width="120" Height="32"
                             Background="#3C3C3C" Foreground="White" BorderBrush="#555"
                             Text="0" Padding="8,4"/>
                    <TextBlock Text="Note" Style="{StaticResource FieldLabel}" Margin="16,0,8,0"/>
                    <TextBox x:Name="txtNote" Width="320" Height="32"
                             Background="#3C3C3C" Foreground="White" BorderBrush="#555"
                             Padding="8,4"/>

                    <StackPanel Orientation="Horizontal" Margin="12,0,0,0">
                        <Button Content="Approve" Click="Approve_Click" Style="{StaticResource SuccessButton}"/>
                        <Button Content="Reject" Click="Reject_Click" Style="{StaticResource DangerButton}"/>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
